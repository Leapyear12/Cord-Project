{
  "name": "chatterbox",
  "version": "1.1.0",
  "private": true,
  "description": "Chatterbox: self-hosted team chat with text channels, threads, voice/video calls and a review-first shared workspace.",
  "type": "module",
  "main": "src/server/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/server/index.js",
    "seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-sqlite.mjs"
  },
  "dependencies": {
    "@socket.io/postgres-adapter": "^0.5.0",
    "@vercel/blob": "^2.9.0",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  }
}
