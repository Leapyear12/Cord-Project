# Copy to .env (or set these in your hosting provider) before running the server.

# HTTP
PORT=4599
HOST=0.0.0.0

# PostgreSQL connection string (required in production)
DATABASE_URL=postgres://chatterbox:chatterbox@localhost:5432/chatterbox

# Optional TLS for the database connection: disable | require | no-verify
# Most managed providers need PGSSL=require (or add ?sslmode=require to DATABASE_URL).
PGSSL=

# Connection pool size
PG_POOL_MAX=10

# Where uploaded files are stored (default: ./data; /tmp on Vercel)
DATA_DIR=./data

# Vercel only: store uploads in Vercel Blob instead of ephemeral disk
# BLOB_READ_WRITE_TOKEN=

# Optional: force the Postgres Socket.IO adapter outside Vercel (auto on Vercel)
# SOCKET_ADAPTER=postgres

# WebRTC. STUN alone works for most home networks; add a TURN server for
# calls between restrictive networks (corporate firewalls, symmetric NAT).
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to production in your hosting platform (enables HSTS and Express prod mode)
# NODE_ENV=production
